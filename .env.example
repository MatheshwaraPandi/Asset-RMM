# Backend environment variables

# Production database:
# Set this to PostgreSQL in production. If omitted, the backend falls back to SQLite for local/dev.
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/asset_rmm

# JWT settings
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_SECONDS=600

# Default admin (created at startup if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
HR_USERNAME=hradmin
HR_PASSWORD=hr123

# CORS (comma-separated list)
CORS_ORIGINS=http://192.168.1.3:3000,http://localhost:3000,http://127.0.0.1:3000

# Backend base URL used by the frontend.
# For browser-side code and packaged builds, use the NEXT_PUBLIC_ variant.
BACKEND_API_URL=http://192.168.1.3:8000
NEXT_PUBLIC_BACKEND_API_URL=http://192.168.1.3:8000
NEXT_PUBLIC_APP_URL=http://192.168.1.3:3000

# NextAuth frontend session settings
NEXTAUTH_URL=http://192.168.1.3:3000
NEXTAUTH_SECRET=change-this-secret

# SMTP for employee OTP login
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
OTP_EMAIL_SUBJECT=Your RMM Lite login code

# Frontend organization branding
NEXT_PUBLIC_ORG_NAME=Acme Systems
NEXT_PUBLIC_ORG_SHORT_NAME=AS
NEXT_PUBLIC_ORG_SUBTITLE=Unified asset operations, repair tracking, and HR visibility
NEXT_PUBLIC_ORG_LOGO_URL=
